# Copy to .env for local development. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is required for the analytics views.
DATABASE_URL=postgres://smartsales:smartsales@localhost:5432/smartsales

# --- Automation -------------------------------------------------------------
# Shared secret that n8n / scheduled jobs send as the X-Automation-Token header.
AUTOMATION_API_KEY=change-me
# Order webhooks (leave N8N_WEBHOOK_URL empty to disable them).
N8N_WEBHOOK_URL=
WEBHOOK_SECRET=change-me-too
# Daily report email (console backend prints the email when no SMTP is configured).
REPORT_RECIPIENTS=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
